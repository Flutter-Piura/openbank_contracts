{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.25.0",
    "generators": {
      "dart-client": {
        "generatorName": "dart-dio",
        "inputSpec": "openapi/openapi.yaml",
        "output": "generated/dart",
        "additionalProperties": {
          "pubName": "openbank_api_client",
          "pubVersion": "0.1.0",
          "pubDescription": "Generated Dart client for the educational OpenBank API",
          "pubHomepage": "https://github.com/Flutter-Piura/openbank_contracts",
          "pubRepository": "https://github.com/Flutter-Piura/openbank_contracts",
          "pubPublishTo": "none",
          "serializationLibrary": "built_value",
          "enumUnknownDefaultCase": true
        }
      }
    }
  }
}
